# Jhon — copy this file to `.env` and fill in your own keys.
# NEVER commit the real `.env` to GitHub.

# Groq API key for the AI agent (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user ID(s), comma-separated — these users get the admin panel
ADMIN_TELEGRAM_IDS=your_telegram_user_id

# Gmail account that sends booking confirmations (needs a Gmail App Password)
EMAIL_ADDRESS=your_gmail_address
EMAIL_APP_PASSWORD=your_gmail_app_password

# Optional — Gmail SMTP defaults are smtp.gmail.com:587
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Optional — where cutoff reports / notifications are emailed
NOTIFY_EMAIL_TO=
RECEPTIONIST_EMAIL=

# Optional — Google Sheets logging (needs a service-account JSON file)
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Optional — website port (default 5000)
PORT=5000
